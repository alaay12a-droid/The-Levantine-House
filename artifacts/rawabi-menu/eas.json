{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://the-levantine-house.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "node": "22.15.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://the-levantine-house.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "ios": {
        "image": "latest",
        "channel": "production"
      },
      "node": "22.15.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://the-levantine-house.onrender.com"
      }
    },
    "production-ios": {
      "extends": "production",
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "applicationId": "com.thelevantinehouse.menu"
      },
      "ios": {
        "ascAppId": "6804418785",
        "bundleIdentifier": "com.thelevantinehouse.menu"
      }
    }
  }
}
