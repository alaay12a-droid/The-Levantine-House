{
  "expo": {
    "name": "البيت الشامي - مندوب",
    "slug": "the-levantine-house-driver",
    "owner": "021837ala",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/thelevantine-house-logo.jpg",
    "scheme": "thelevantinehouse-driver",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/thelevantine-house-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0F0A05"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thelevantinehouse.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لإرسال موقعك للعميل أثناء التوصيل",
        "NSLocationAlwaysUsageDescription": "نحتاج موقعك في الخلفية لإرسال موقعك للعميل طوال رحلة التوصيل",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "نحتاج موقعك في الخلفية لإرسال موقعك للعميل طوال رحلة التوصيل",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.thelevantinehouse.driver",
      "versionCode": 30,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/thelevantine-house-logo.jpg",
        "backgroundColor": "#0F0A05"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نحتاج موقعك في الخلفية لإرسال موقعك للعميل طوال رحلة التوصيل."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "color": "#C8171A",
          "sounds": [
            "./assets/sounds/notification_loop.wav",
            "./assets/sounds/notification.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83b4e404-a637-4f64-b77c-0c397246e99e"
      }
    }
  }
}
