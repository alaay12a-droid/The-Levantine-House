modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/rawabi-driver: expo"

[[workflows.workflow]]
name = "artifacts/rawabi-driver: expo"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8099 pnpm --filter @workspace/the-levantine-house-driver run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_API_BASE_URL = "https://the-levantine-house-45jt.onrender.com"
SEED_LEGACY_DATA = "false"
ADMIN_USERNAME = "admin"
SEED_ADMIN = "false"
EXPO_PUBLIC_API_BASE_URL = "https://the-levantine-house-45jt.onrender.com"
CORS_ALLOWED_ORIGINS = "https://the-levantine-house-45jt.onrender.com,https://the-levantine-house-dashboard.onrender.com"
